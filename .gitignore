# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.egg-info/
.eggs/
build/
dist/

# Virtual env
.venv/
venv/
env/

# IDE / editors
.spyproject/
.idea/
.vscode/
*.swp

# Tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.coverage
htmlcov/


# Data (not tracked — vive sotto data/)
data/
*.tif
*.tiff
*.tif.lock

# …but the paper-companion data subset IS tracked (small numerical
# artifacts that need to ship with the manuscript)
!paper/data/
!paper/data/**

# Outputs
output/
runs/

# OneDrive transient files
*.tmp
~$*
.~lock.*

# Docs build output
site/

# OS
.DS_Store
Thumbs.db

# Legacy/local
pythonProject/
your_input_directory_path/

# --- tracked exception -------------------------------------------------
# The IBM Quantum hardware outputs ARE tracked. The manuscript's Data
# availability statement points readers at this directory, and §7 asks them
# to re-run scripts/analyse_hw_signal.py over exactly these counts to check
# the peakedness and null-baseline argument for themselves. Placed last so
# it wins over the `data/` and `output/` rules above (last match wins).
!data/
data/*
!data/output/
data/output/*
!data/output/ibm_hw/
!data/output/ibm_hw/**

# Manuscript and paper build scripts: kept local, not published
paper/
scripts/*paper*
